# Номер инстанса (любое число; в запросах /waInstance{WAGATE_ID}/...)
WAGATE_ID=1101000001
# Секрет API: длинная случайная строка
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WAGATE_TOKEN=
# Где слушать. 127.0.0.1 — только с этого сервера (снаружи через Caddy/nginx с HTTPS)
HOST=127.0.0.1
PORT=3000
# Сессия WhatsApp, входящие, исходящие, стоп-лист: файлы в DATA_DIR
DATA_DIR=data
# ...или Postgres (для хостинга без постоянного диска: Render + Neon). Если задан — файлы не используются
DATABASE_URL=
# Рабочий номер: шлюз сам запросит код привязки и напишет его в лог (удобно, когда нет консоли)
PAIR_PHONE=
# Куда пересылать входящие (необязательно). Формат тела как у вебхуков Green-API
WEBHOOK_URL=
WEBHOOK_TOKEN=
# Правила отправки
DAILY_NEW_CHATS=15
MIN_INTERVAL_SEC=120
ENFORCE_HOURS=true
WORK_HOURS=9-18
WORK_DAYS=1-5
MAX_LENGTH=2000
LOG_LEVEL=info
